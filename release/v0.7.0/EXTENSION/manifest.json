{
  "manifest_version": 3,
  "name": "MetaChat Sidecar Canary",
  "version": "0.7.0",
  "description": "Immutable v0.7.0 diagnostic and explicit draft placement canary.",
  "key": "",
  "permissions": ["storage", "sidePanel", "nativeMessaging"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {"service_worker": "dist/service-worker.js"},
  "side_panel": {"default_path": "dist/sidepanel.html"},
  "action": {"default_title": "MetaChat v0.7.0"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["dist/content-script.js"],
    "run_at": "document_idle",
    "world": "ISOLATED"
  }]
}
